<div class="text-center mb-4">
  <%= image_tag "group_pool.jpg", class: "img-fluid rounded", style: "max-width: 700px;" %>
</div>

<h2><%= @group.name %></h2>

<p><%= @group.introduction %></p>

<p>Owner: <%= @group.owner.name %></p>

<% if @group.owner_id != current_user.id %>
  <% if @group.users.include?(current_user) %>
    <%= button_to "Leave this group", group_leave_path(@group), method: :delete, class: "btn btn-danger mt-2" %>
  <% else %>
    <%= button_to "Join this group", group_join_path(@group), method: :post, class: "btn btn-success mt-2" %>
  <% end %>
<% end %>

<div class="mt-3">
  <%= link_to "イベント一覧へ", group_events_path(@group), class: "btn btn-info" %>

  <% if @group.owner_id == current_user.id %>
    <%= link_to "イベント通知", group_new_event_path(@group), class: "btn btn-warning text-white ms-2" %>
  <% end %>
</div>
